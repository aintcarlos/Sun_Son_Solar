
# Environment files and secrets
.env
.env.*
!.env.example

# Dependencies
/vendor/

# CodeIgniter runtime files
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/uploads/*

# Keep placeholder files, if present
!/writable/cache/.gitkeep
!/writable/logs/.gitkeep
!/writable/session/.gitkeep
!/writable/uploads/.gitkeep

# IDE and operating system files
/.idea/
/.vscode/
.DS_Store
Thumbs.db
